# Какой LLM использовать: deepseek | gigachat | mock
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-совместимый API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GigaChat (заполнить, когда появится доступ)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=


# Распознавание речи на сервере (faster-whisper): small | base | medium
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# МТС Exolve — звонок продавцу на настоящий телефон
EXOLVE_API_KEY=
EXOLVE_VOICE=13
SELLER_PHONE=
# На публичном сервере обязательно: без PIN любой посетитель сможет звонить за ваш счёт
PHONE_PIN=

# База агента: пользователи, история диалогов, объявления с признаками.
# По умолчанию SQLite в backend/data/app.db; PostgreSQL — postgresql+psycopg://user:pass@host/db
DATABASE_URL=
AUTH_SESSION_DAYS=30
# true — cookie только по HTTPS (на сервере с https обязательно)
COOKIE_SECURE=false

# Ночной обход объявлений по поискам клиентов: время ЧЧ:ММ (пусто — выключен)
REFRESH_AT=
REFRESH_PAGES=3
REFRESH_CHECK_LIMIT=40

# 2GIS Places API — серверный ключ каталога. Без ключа работает OpenStreetMap.
TWOGIS_API_KEY=
# Общий бюджет проверки инфраструктуры на один поиск (секунды).
PLACES_BUDGET_S=12
