# Какой LLM использовать: deepseek | gigachat
LLM_PROVIDER=gigachat

# DeepSeek (OpenAI-совместимый API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

# GigaChat: готовый Authorization Key без префикса Basic.
# При наличии Client ID и Client Secret: base64 от строки Client ID:Client Secret.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL=true
# Необязательно: свой CA bundle. Сертификат НУЦ Минцифры включён в backend/certs.
GIGACHAT_CA_BUNDLE=

# Защита демо от зависаний и перегрузки (один процесс backend).
# Активная работа одного хода; ожидание ответа человека не учитывается.
AGENT_TURN_TIMEOUT_S=120
# Число ожидающих генерацию GigaChat, помимо одного выполняемого запроса.
GIGACHAT_QUEUE_SIZE=6
GIGACHAT_QUEUE_TIMEOUT_S=25
# Весь вызов модели, включая OAuth/повторы, после выхода из очереди.
LLM_CALL_TIMEOUT_S=60


# Распознавание речи на сервере (faster-whisper): small | base | medium
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# МТС Exolve — звонок продавцу на настоящий телефон
EXOLVE_API_KEY=
EXOLVE_VOICE=13
SELLER_PHONE=
# Альтернативный операторский доступ. Без PIN разрешён только премиум-аккаунт пилота.
PHONE_PIN=

# База агента: пользователи, история диалогов, объявления с признаками.
# По умолчанию SQLite в backend/data/app.db; PostgreSQL — postgresql+psycopg://user:pass@host/db
DATABASE_URL=
AUTH_SESSION_DAYS=30
# true — cookie только по HTTPS (на сервере с https обязательно)
COOKIE_SECURE=false

# Ночной обход объявлений по поискам клиентов: время ЧЧ:ММ (пусто — выключен)
REFRESH_AT=
REFRESH_PAGES=3
REFRESH_CHECK_LIMIT=40

# 2GIS — серверный ключ с доступом к каталогу и Raster Tiles API (подложка карты).
# Без ключа или при ошибке сервиса работает OpenStreetMap.
TWOGIS_API_KEY=
# Общий бюджет проверки инфраструктуры на один поиск (секунды).
PLACES_BUDGET_S=12

# Закрытый премиум-пилот: nanobot в отдельном контейнере, модель независимо от LLM_PROVIDER.
# Доступ дополнительно требует premium=true и адрес darkyhat@mail.ru.
WORKSHOP_LLM_PROVIDER=deepseek
WORKSHOP_IMAGE=mesto-workshop:0.4.2
WORKSHOP_DOCKER=/usr/bin/docker
# WORKSHOP_ROOT=/private/path/to/workshop

# Разбор простых сообщений кодом без модели (agent/rule_parser.py):
#   on — по умолчанию: простое сообщение («двушка в Казани до 9 млн») разбирается кодом;
#   shadow — решает модель, разбор кодом сравнивается с ней; off — выключено.
RULE_PARSER=on
# Свой сервер Overpass для сборки геоданных (scripts/build_geodata.py), если стандартные недоступны
OVERPASS_URL=
